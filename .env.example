# AI Marketplace Environment Configuration
# Copy this file to .env and update values

# Server
PORT=3000

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Encryption Key for API keys (32 chars minimum)
ENCRYPTION_KEY=your-32-character-encryption-key-here-for-api-key-encryption

# CORS Origin (for frontend)
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_marketplace
DB_USER=postgres
DB_PASSWORD=secure-postgres-password

# Provider API Keys (for providers that need them)
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# GitHub Personal Access Token (for pushing updates)
GITHUB_PAT=ghp_your_github_pat_here
GITHUB_REPO=EliasL-git/byld-converse
GITHUB_BRANCH=main

# Cryptography
# ENCRYPTION_KEY should be exactly 32 characters
# Used for AES-256-CBC encryption of API keys